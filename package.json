{
  "name": "system-int",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npm run i18n:check && eslint .",
    "typecheck": "npm run i18n:check && tsc --noEmit",
    "i18n:check": "node scripts/i18n-audit.mjs",
    "test:answer-review": "node --no-warnings --experimental-strip-types scripts/validate-answer-review.mjs",
    "test:flowchart-responsive": "node --no-warnings --experimental-strip-types scripts/validate-flowchart-responsive.mjs",
    "test:week4-content": "node --no-warnings --experimental-strip-types scripts/validate-week4-content.mjs",
    "test:week4-module3-save": "node scripts/validate-week4-module3-save.mjs",
    "test:week5-delay-trail": "node --no-warnings --experimental-strip-types scripts/validate-week5-delay-trail.mjs",
    "test:week5-problem-hunter": "node --no-warnings --experimental-strip-types scripts/validate-week5-problem-hunter.mjs",
    "test:week5-balance-master": "node --no-warnings --experimental-strip-types scripts/validate-week5-balance-master.mjs",
    "test:week6-modules": "node --no-warnings --experimental-strip-types scripts/validate-week6-modules.mjs",
    "test:module-revisions": "node --no-warnings --experimental-strip-types scripts/validate-module-revisions.mjs",
    "test:run-replay": "node --no-warnings --experimental-strip-types scripts/validate-run-replay.mjs",
    "test:run-load": "node scripts/report-run-load.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "canvas-confetti": "latest",
    "clsx": "latest",
    "framer-motion": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "qrcode.react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/canvas-confetti": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
