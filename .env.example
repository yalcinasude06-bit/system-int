NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Çoklu öğretmen yapılandırması (gerçek parolaları asla bu dosyaya yazmayın).
TEACHER_ACCOUNTS=[{"username":"admin","password":"degistirin-admin"},{"username":"ogretmen2","password":"degistirin-ogretmen2"},{"username":"ogretmen3","password":"degistirin-ogretmen3"},{"username":"ogretmen4","password":"degistirin-ogretmen4"},{"username":"ogretmen5","password":"degistirin-ogretmen5"}]
# Oturum imzalama anahtarı; öğretmen parolalarından farklı, uzun ve rastgele olmalıdır.
TEACHER_TOKEN_SECRET=uzun-rastgele-ve-ayri-bir-imzalama-anahtari-belirleyin
# Veri sıfırlama yalnızca geçici test ortamlarında açık olabilir; Production'da daima false bırakın.
ENABLE_DATA_RESET=false
